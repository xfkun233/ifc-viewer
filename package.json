    "element-plus": "^2.13.1",
    "geotiff": "^3.0.4",
    "online-3d-viewer": "^0.18.0",
    "pinia": "^3.0.4",
    "proj4": "^2.20.4",
    "three": "^0.182.0",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4",
    "web-ifc": "^0.0.74"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.3",
